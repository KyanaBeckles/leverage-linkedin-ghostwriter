{
  "name": "leverage-linkedin-ghostwriter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply leverage-ghostwriter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leverage-ghostwriter-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
